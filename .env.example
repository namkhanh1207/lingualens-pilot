# Copy to .env.local on your machine. Set remote values separately in Vercel.
# Local development: file:pilot-local.db. Vercel MUST use a persistent Turso URL.
TURSO_DATABASE_URL=file:pilot-local.db
TURSO_AUTH_TOKEN=
# Set the exact final Vercel origin, without a trailing slash. Locally leave blank.
APP_ORIGIN=
ADMIN_EMAILS=donamkhanh127@gmail.com
RESEARCHER_EMAILS=
MODERATOR_EMAILS=
# Leave AI disabled to keep the pilot independent of paid AI APIs.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
