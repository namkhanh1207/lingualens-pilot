{
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run test:unit)",
      "Bash(npm run build)",
      "Bash(npm run ui:snapshot:*)",
      "Bash(node tests/*)",
      "Bash(node scripts/sync-agent-skills.mjs)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git worktree list)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.pilot-private/**)",
      "Read(./**/*.db)",
      "Edit(./.pilot-private/**)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Bash(npm publish:*)",
      "Bash(vercel:*)",
      "Bash(turso:*)"
    ]
  }
}
